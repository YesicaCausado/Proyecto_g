{
  "version": 2,

  "buildCommand": "cd frontend && npm ci && npm run build",

  "outputDirectory": "frontend/dist",

  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "api/**/*.py,backend/app/**/*.py,backend/data/**/*.json",
      "excludeFiles": "{frontend/**,docs/**,scripts/**,.github/**,.npm-cache/**,audit-output/**,backend/tests/**,backend/scripts/**,backend/migrations/**,backend/docs/**,backend/*.db,backend/*.sqlite*}"
    }
  },

  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/redoc",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/redoc",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
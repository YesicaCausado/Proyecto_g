# ==========================================
# NeuroLearn AI - Environment Template
# ==========================================

# Database (Supabase o PostgreSQL)
DATABASE_URL=YOUR_DATABASE_URL

# JWT Security
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256

# Groq — LLM principal
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3-32b

# Gemini — fallback secundario (opcional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# App
APP_NAME=NeuroLearn AI
APP_VERSION=1.0.0
DEBUG=false

# Environment
VERCEL_ENV=development

# Umbrales de inferencia cognitiva
FATIGUE_THRESHOLD=0.7
OVERLOAD_THRESHOLD=0.8
DOUBT_THRESHOLD=0.6
MASTERY_THRESHOLD=0.85

# ==========================================
# Google OAuth 2.0 — Integraciones (Docente Pro)
# ==========================================
# Credenciales de la app OAuth creada en Google Cloud Console
# (https://console.cloud.google.com/apis/credentials).
# NUNCA colocar estos valores en el frontend o en el repositorio.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# URL de callback registrada en Google (debe coincidir exactamente).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Alcances mínimos: lectura de Drive + eventos del calendario.
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.readonly openid
# Origen del frontend al que se redirige al terminar el flujo OAuth.
FRONTEND_URL=http://localhost:5173

# Nota: los access/refresh tokens de Google se cifran con SECRET_KEY y se
# guardan en la tabla `integrations`. Nunca viajan al frontend.

# ==========================================
# NeuroLearn AI - Environment Template
# ==========================================

# Database (Supabase o PostgreSQL)
DATABASE_URL=YOUR_DATABASE_URL

# JWT Security
SECRET_KEY=YOUR_SECRET_KEY
ALGORITHM=HS256

# Groq — LLM principal
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3-32b

# Gemini — fallback secundario (opcional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Timeout HTTP de las llamadas a IA (segundos). Menor que el maxDuration de
# Vercel para que un proveedor colgado no mate la función (evita el "error
# en el tutor IA" intermitente del cold start).
AI_HTTP_TIMEOUT=15
# Presupuesto del tutor de chat: máx. por proveedor y total (Groq + Gemini).
# El total debe dejar margen para la BD dentro de los 30 s de Vercel.
AI_CHAT_REQUEST_TIMEOUT=9
AI_CHAT_TOTAL_TIMEOUT=18

# App
APP_NAME=NeuroLearn AI
APP_VERSION=1.0.0
DEBUG=false

# Environment
VERCEL_ENV=development

# Umbrales de inferencia cognitiva
FATIGUE_THRESHOLD=0.7
OVERLOAD_THRESHOLD=0.8
DOUBT_THRESHOLD=0.6
MASTERY_THRESHOLD=0.85

# ==========================================
# Google OAuth 2.0 — Integraciones (Docente Pro)
# ==========================================
# Credenciales de la app OAuth creada en Google Cloud Console
# (https://console.cloud.google.com/apis/credentials).
# NUNCA colocar estos valores en el frontend o en el repositorio.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# URL de callback registrada en Google (debe coincidir exactamente).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Alcances por proveedor (opcionales; estos son los valores por defecto).
# Conectar Drive ya no pide Calendar ni viceversa. GOOGLE_SCOPES ya no se usa.
GOOGLE_DRIVE_SCOPES=openid email https://www.googleapis.com/auth/drive.readonly
GOOGLE_CALENDAR_SCOPES=openid email https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/calendar.events
# Origen del frontend al que se redirige al terminar el flujo OAuth.
FRONTEND_URL=http://localhost:5173

# Nota: los access/refresh tokens de Google se cifran con SECRET_KEY y se
# guardan en la tabla `integrations`. Nunca viajan al frontend.
